# Small-host image (Render free: 512 MB, 0.1 CPU): no PyTorch (the dynacard CNN runs in numpy from
# backend/models/dynacard_cnn.npz), twin built in the background so health checks pass during startup.
FROM node:24-slim AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    TWIN_BACKGROUND_START=1 MALLOC_ARENA_MAX=2 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    TICK_SECONDS=2.0 SIM_HOURS_PER_TICK=4.0
WORKDIR /app/backend
COPY backend/requirements.txt ./
RUN pip install -r requirements.txt
COPY backend/ ./
COPY --from=ui /ui/dist /app/frontend/dist
RUN python -m app.train
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --ws-ping-interval 20"]
